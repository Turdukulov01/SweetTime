server {
    listen 80;
    server_name lnp-corporation.duckdns.org;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name lnp-corporation.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/lnp-corporation.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lnp-corporation.duckdns.org/privkey.pem;

    # Backend accepts at most 50 MiB MP4 payloads plus multipart overhead.
    client_max_body_size 52M;

    # Temporary upload files must never be public, even while an upload is in progress.
    location ^~ /media/temp/ {
        deny all;
    }

    location ^~ /media/ {
        alias /srv/sweetime/media/;
        autoindex off;
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
        max_ranges 1;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
