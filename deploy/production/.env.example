POSTGRES_DB=sweettime
POSTGRES_USER=sweettime
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-secret
# Password in DATABASE_URL must be URL-encoded when it contains reserved characters.
DATABASE_URL=postgresql+psycopg://sweettime:replace-with-url-encoded-password@postgres:5432/sweettime
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=["https://admin.sweetime.kg"]
MEDIA_PUBLIC_BASE_URL=https://api.sweetime.kg/media
OTP_MODE=disabled
SEED_MODE=none

# API is private to the host reverse proxy until a TLS topology is approved.
SWEETIME_HTTP_BIND=127.0.0.1
SWEETIME_HTTP_PORT=8080
SWEETIME_IMAGE_TAG=local

# Должны совпадать с владельцем /srv/sweetime/media на физическом сервере.
SWEETIME_UID=1000
SWEETIME_GID=1000
