# Copy this to .env.local and fill in real values for development.
# Never commit .env.local.

# Base URL of the backend REST API (Этап 13).
# Defaults to "/api" (Next.js Route Handlers) when not set.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Google OAuth (when using NextAuth or custom OAuth flow)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple OAuth
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=

# Optionally used by next/font self-hosting
# NEXT_FONT_GOOGLE_PROXY=
